# Copiar a .env antes de `docker compose up`. Sin valores reales: todos son ejemplos de desarrollo local.

# Puertos publicados al host (configurables por si ya están ocupados).
POSTGRES_PORT=5432
REDIS_PORT=6379
MOSQUITTO_PORT=1883
API_PORT=3000

# PostgreSQL
POSTGRES_USER=coldchain
POSTGRES_PASSWORD=coldchain
POSTGRES_DB=coldchain

# Mosquitto Dynamic Security (ver ADR 0004). El admin solo lo usa el broker al arrancar
# por primera vez; la API nunca lo necesita (administra dynsec en spec 002).
MOSQUITTO_ADMIN_USERNAME=admin
MOSQUITTO_ADMIN_PASSWORD=changeme

# Cliente de servicio MQTT que usa la API para suscribirse a devices/+/telemetry.
MQTT_SERVICE_USERNAME=api-service
MQTT_SERVICE_PASSWORD=changeme
